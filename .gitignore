# ==========================================
# Antarctic Streaming Platform .gitignore
# ==========================================

# --- Environment & Sensitive Credentials ---
.env
.env.*
*.env
!.env.example
!.env*.example

# --- AI, Assistant & Agent Artifacts ---
agent.md
AGENT.md
agents.md
AGENTS.md
*.agent.md
.agent/
.agents/
CLAUDE.md
.claude/
.cursor/
.cursorrules
.gemini/
.antigravity/
.assistant/
ai-instructions.md
prompt.md
prompts/
*copilot*

# --- Dependencies ---
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.backup

# --- Build Outputs & Caches ---
dist/
dist-ssr/
build/
out/
.cache/
.vite/
*.tsbuildinfo

# --- Android Build & Local Properties ---
client/android/.gradle/
client/android/build/
client/android/app/build/
client/android/local.properties
client/android/app/src/main/assets/public/
*.apk
!client/public/downloads/*.apk
*.aab
*.ap_
*.dex
*.keystore
*.jks

# --- OS System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDEs & Editors ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- Logs & Runtime ---
*.log
logs/
*.pid
*.seed
*.pid.lock
